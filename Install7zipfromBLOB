$ErrorActionPreference = 'Stop'

# 1) Download your PSADT bundle
$ZipUrl  = 'https://avdmgmdeployapps.blob.core.windows.net/deployapps/7Zip.zip?sp=r&st=2025-09-15T14:16:00Z&se=2099-09-15T22:31:00Z&spr=https&sv=2024-11-04&sr=b&sig=KmqjqZ8F9n0GLfDJOQCJmz0vYg51iK1uwmVeuYOpv70%3D'
$Stage   = 'C:\AIB\Stage\7zip'
$ZipPath = Join-Path $Stage '7Zip_PSADT.zip'
New-Item -Path $Stage -ItemType Directory -Force | Out-Null
Invoke-WebRequest -Uri $ZipUrl -OutFile $ZipPath

# 2) Expand bundle
Expand-Archive -Path $ZipPath -DestinationPath $Stage -Force

# If the ZIP extracts into a single subfolder, pick it; otherwise keep $Stage
$pkgRoot = (Get-ChildItem -Directory -Path $Stage | Select-Object -First 1).FullName
if (-not $pkgRoot) { $pkgRoot = $Stage }

# 3) Run PSADT silently in SYSTEM/NonInteractive
$deploy = Join-Path $pkgRoot 'Deploy-Application.ps1'
& powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File $deploy -DeploymentType Install -DeployMode NonInteractive

# 4) Optional cleanup
Remove-Item $Stage -Recurse -Force
