$ErrorActionPreference = 'Stop'
# Enforce TLS 1.2 just in case
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# 1) Download your PSADT bundle
$ZipUrl  = 'https://avdmgmdeployapps.blob.core.windows.net/deployapps/7Zip.zip?sp=r&st=2025-09-16T12:23:44Z&se=2030-09-16T20:38:44Z&spr=https&sv=2024-11-04&sr=b&sig=k%2BH4EB7FsRYUp2HSFlbeAfmtUXDvkszO1%2BsEwTaYpks%3D'
$Stage   = 'C:\AIB\Stage\7zip'
$ZipPath = Join-Path $Stage '7Zip_PSADT.zip'
New-Item -Path $Stage -ItemType Directory -Force | Out-Null

# Sanity: make sure this looks like a blob SAS with read
if ($ZipUrl -notmatch '\?sv=.*\bsr=b\b' -or $ZipUrl -notmatch '\bsp=.*\br\b') {
  throw "ZipUrl must be a **blob** SAS with **read** permission (sr=b, sp=r)."
}
# HEAD first so we fail fast on bad SAS
Invoke-WebRequest -Uri $ZipUrl -Method Head -UseBasicParsing | Out-Null

# Download
Invoke-WebRequest -Uri $ZipUrl -OutFile $ZipPath -UseBasicParsing

# 2) Expand bundle
Expand-Archive -LiteralPath $ZipPath -DestinationPath $Stage -Force

# 3) Locate Deploy-Application.ps1 (works even if ZIP created an extra folder)
$deploy = Get-ChildItem -Path $Stage -Filter 'Deploy-Application.ps1' -Recurse -File | Select-Object -First 1
if (-not $deploy) { throw "Deploy-Application.ps1 not found under $Stage" }

# 4) Run PSADT silently and surface its exit code
$argList = @('-NoLogo','-NoProfile','-ExecutionPolicy','Bypass','-File', $deploy.FullName, '-DeploymentType','Install','-DeployMode','NonInteractive')
$proc = Start-Process -FilePath 'powershell.exe' -ArgumentList $argList -Wait -PassThru
if ($proc.ExitCode -ne 0) { throw "PSADT failed with exit code $($proc.ExitCode)." }

# 5) Optional cleanup (comment out if you want logs/artifacts for troubleshooting)
Remove-Item $Stage -Recurse -Force
